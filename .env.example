# Provider: gemini ou deepseek (default: gemini)
PROVIDER=gemini

# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger endpoints (opcional)
API_KEY=sua-chave-secreta-aqui

# Credenciais Gemini (OPCIONAL - para login automatizado)
# Se não fornecidas, o navegador abrirá para login manual
GEMINI_EMAIL=seu-email@gmail.com
GEMINI_PASSWORD=sua-senha

# Credenciais DeepSeek (OPCIONAL - para login automatizado)
DEEPSEEK_EMAIL=seu-email@exemplo.com
DEEPSEEK_PASSWORD=sua-senha

# Configurações Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Logging
LOG_LEVEL=info
